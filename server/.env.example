# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
JWT_SECRET=change-me-in-production
# Login attempts per 15 min per IP (default 20; raise for local dev)
# AUTH_RATE_LIMIT=20

# Database
DATABASE_URL=postgresql://nouvii:nouvii_dev@localhost:5432/nouvii

# Storage: 'local' (dev, files on disk) or 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3_BUCKET=nouvii-photos
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Google Calendar OAuth (optional — feature disabled when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# Claude Vision auto-tagging (optional — feature disabled when unset)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Web Push (optional — npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Cloudflare R2 (S3-compatible primary storage): also set STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=nouvii-photos
# S3_REGION=auto
# S3_PUBLIC_BASE_URL=https://<bucket-public>.r2.dev
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= (R2 API token)

# Google Drive backup mirror (optional)
# GDRIVE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
# GDRIVE_FOLDER_ID=

# Instagram analytics (Meta Graph API) — create a Business app at
# developers.facebook.com, add Facebook Login for Business, and register
# META_REDIRECT_URL as a valid OAuth redirect URI.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URL=http://localhost:4000/api/analytics/oauth/callback
# Web app origin the OAuth callback redirects back to (defaults to the
# first CORS_ORIGIN entry).
WEB_ORIGIN=

# Instagram-only login (no Facebook Page needed) — add the "Instagram"
# product to the same Meta app ("API setup with Instagram business login"),
# copy the Instagram App ID/Secret from that tab, and register
# IG_REDIRECT_URL as a valid OAuth redirect there.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URL=http://localhost:4000/api/analytics/oauth/instagram/callback
