# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
JWT_SECRET=change-me-in-production
# Login attempts per 15 min per IP (default 20; raise for local dev)
# AUTH_RATE_LIMIT=20

# Database
DATABASE_URL=postgresql://nouvii:nouvii_dev@localhost:5432/nouvii

# Storage: 'local' (dev, files on disk) or 's3'
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3_BUCKET=nouvii-photos
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Google Calendar OAuth (optional — feature disabled when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# Claude Vision auto-tagging (optional — feature disabled when unset)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Web Push (optional — npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
